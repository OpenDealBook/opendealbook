{
  "name": "@odb/data-room",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "typesVersions": {
    "*": {
      "*": [
        "src/*"
      ]
    }
  },
  "exports": {
    ".": "./src/index.ts",
    "./server": "./src/server.ts",
    "./uploads/actions": "./src/uploads/actions.ts",

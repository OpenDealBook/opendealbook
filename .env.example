# OpenDealbook local-development environment.
# Copy to `.env` and fill in the secrets. `.env` is gitignored; never commit real secrets.
# These values feed docker-compose.yml, which also runs Supabase (profile: core). The
# localhost ports noted below are slot 0, the main checkout: Supabase API 54321, Postgres
# 54322, Studio 54323, Mailpit UI 54324 and SMTP 54325. Each git worktree gets its own
# slot, compose project and ports from bin/worktree-env.sh, loaded by .envrc.
#
# Worktrees:
#   pnpm worktree:up <branch>  an isolated worktree with its own slot, stack and seeded DB
#   pnpm worktree:start        start the current checkout's compose core stack
#   pnpm worktree:status       list every slot, its ports and running containers
#   pnpm worktree:down [path]  remove a worktree, its stack and volumes, and free its slot
# Database tools target $SUPABASE_DB_URL (slot 0 when unset): pnpm db:migrate,
# pnpm db:seed, pnpm db:test (pgTAP), pnpm db:types.

# --- Temporal (workflows) -------------------------------------------------------------
# Server gRPC: localhost:7233   UI: http://localhost:8233
TEMPORAL_DB_USER=temporal
TEMPORAL_DB_PASSWORD=temporal
TEMPORAL_DB_NAME=temporal
TEMPORAL_UI_CORS_ORIGINS=http://localhost:3000

# --- Nango (integrations) -------------------------------------------------------------
# Dashboard/API: http://localhost:3003
NANGO_DB_USER=nango
NANGO_DB_PASSWORD=nango
NANGO_DB_NAME=nango
# 32-byte base64 key. docker-compose.yml has a local-dev default; override it with a generated
# value anywhere other than a local machine. Generate with: openssl rand -base64 32
NANGO_ENCRYPTION_KEY=
NANGO_SERVER_URL=http://localhost:3003
NANGO_DASHBOARD_USERNAME=admin
NANGO_DASHBOARD_PASSWORD=admin

# Object storage is Supabase Storage (S3-compatible, local API on 54321 under /storage/v1),
# provided by the compose core profile; no keys are needed here.

# --- Gotenberg (DOCX -> PDF conversion) ----------------------------------------------
# LibreOffice conversion API: http://localhost:3009. Read by @odb/templates when
# converting generated DOCX files to PDF.
GOTENBERG_URL=http://localhost:3009

# --- Documenso (e-sign) ---------------------------------------------------------------
# App: http://localhost:3005
# Requires infra/documenso/cert.p12 (see infra/documenso/README.md).
DOCUMENSO_DB_USER=documenso
DOCUMENSO_DB_PASSWORD=documenso
DOCUMENSO_DB_NAME=documenso
DOCUMENSO_URL=http://localhost:3005
# API token created in Documenso (Team settings > API Tokens). Read by the web app.
DOCUMENSO_API_KEY=
# Secret set on the Documenso webhook (Team settings > Webhooks) that points at
# http://host.docker.internal:3000/api/webhooks/documenso, at least 32 characters
# (openssl rand -hex 32). The web app refuses every webhook until this is set to the
# same value.
DOCUMENSO_WEBHOOK_SECRET=
# docker-compose.yml has local-dev defaults for these; override them with generated values anywhere
# other than a local machine. Generate each secret with: openssl rand -base64 32
DOCUMENSO_NEXTAUTH_SECRET=
DOCUMENSO_ENCRYPTION_KEY=
DOCUMENSO_ENCRYPTION_SECONDARY_KEY=
# Passphrase used when creating cert.p12 (see infra/documenso/README.md).
DOCUMENSO_SIGNING_PASSPHRASE=changeit
# Mailpit by its compose network hostname, so every worktree slot shares it.
DOCUMENSO_SMTP_TRANSPORT=smtp-auth
DOCUMENSO_SMTP_HOST=mailpit
DOCUMENSO_SMTP_PORT=1025
DOCUMENSO_SMTP_USERNAME=
DOCUMENSO_SMTP_PASSWORD=
DOCUMENSO_SMTP_FROM_NAME=OpenDealbook Local
DOCUMENSO_SMTP_FROM_ADDRESS=noreply@opendealbook.local

# --- Novu (notifications, profile: notifications) ------------------------------------
# Self-hosted Novu CE. Slot 0 UIs/APIs on localhost:
#   API: http://localhost:3006   WS: http://localhost:3007   Dashboard: http://localhost:3008
# A worktree's .envrc exports its own NOVU_API_URL and NOVU_WS_URL.
# MongoDB and novu-redis are internal to the compose network (not published).
NOVU_MONGO_USER=root
NOVU_MONGO_PASSWORD=secret
# docker-compose.yml has local-dev defaults for these two; override them with generated values
# anywhere other than a local machine. Generate each secret with: openssl rand -base64 32
NOVU_JWT_SECRET=
NOVU_SECRET_KEY=
# Encrypts stored provider credentials; must be EXACTLY 32 characters. docker-compose.yml has a
# local-dev default; override it with a generated value anywhere other than a local machine.
NOVU_STORE_ENCRYPTION_KEY=
NOVU_NODE_ENV=local
NOVU_DISABLE_USER_REGISTRATION=false
NOVU_API_ROOT_URL=http://localhost:3006
NOVU_WS_URL=http://localhost:3007
# Hosts Novu may call although they resolve to private addresses: the app's bridge at
# /api/novu and a private SMTP host. Comma-separated hostnames, .suffixes, IPs, or CIDRs.
# Empty uses the compose default, host.docker.internal.
NOVU_SAFE_OUTBOUND_ALLOW=
# App-side: @odb/notifications reaches the Novu API from the host at NOVU_API_URL and
# authenticates with the API key created in the Novu dashboard after first startup.
NOVU_API_URL=http://localhost:3006
NOVU_API_KEY=

# --- Observability (profile: observability) ------------------------------------------
# Grafana LGTM + profiling stack. Slot 0 UIs:
#   Prometheus: http://localhost:19090  Grafana: http://localhost:3001
#   Loki: http://localhost:13100        Tempo:   http://localhost:3200
#   Pyroscope: http://localhost:4040    OTLP:    grpc 14317 / http 14318
# A worktree's .envrc exports its own OTEL_EXPORTER_OTLP_ENDPOINT, PYROSCOPE_SERVER_ADDRESS
# and DOCLING_URL.
# Each host port can be overridden for docker compose: PROMETHEUS_PORT, GRAFANA_PORT,
# LOKI_PORT, TEMPO_PORT, PYROSCOPE_PORT, BLACKBOX_EXPORTER_PORT,
# OTEL_COLLECTOR_GRPC_PORT, OTEL_COLLECTOR_HTTP_PORT, OTEL_COLLECTOR_HEALTH_PORT.
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin

# App instrumentation endpoints (consumed by the app OTEL + profiling wiring, a separate
# later lane). These point at the collector and Pyroscope on published localhost ports.
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:14318
OTEL_SERVICE_NAME=opendealbook-web
PYROSCOPE_SERVER_ADDRESS=http://localhost:4040

# OpenDealbook local-development environment.
# Copy to `.env` and fill in the secrets. `.env` is gitignored; never commit real secrets.
# These values feed docker-compose.yml. Supabase itself is configured by the Supabase CLI
# (apps/web/supabase/config.toml), not here.
#
# Supabase coexistence: `supabase start` exposes API on 54321 and Postgres on 54322.
# Compose services reach it via host.docker.internal:54321 / :54322. The app and Supabase
# Edge Functions reach compose services via the localhost ports noted below.

# --- Temporal (workflows) -------------------------------------------------------------
# Server gRPC: localhost:7233   UI: http://localhost:8233
TEMPORAL_DB_USER=temporal
TEMPORAL_DB_PASSWORD=temporal
TEMPORAL_DB_NAME=temporal
TEMPORAL_UI_CORS_ORIGINS=http://localhost:3000

# --- Nango (integrations) -------------------------------------------------------------
# Dashboard/API: http://localhost:3003
NANGO_DB_USER=nango
NANGO_DB_PASSWORD=nango
NANGO_DB_NAME=nango
# 32-byte base64 key. Generate with: openssl rand -base64 32
NANGO_ENCRYPTION_KEY=
NANGO_SERVER_URL=http://localhost:3003
NANGO_DASHBOARD_USERNAME=admin
NANGO_DASHBOARD_PASSWORD=admin

# Object storage is Supabase Storage (S3-compatible, local API on 54321 under /storage/v1),
# provided by the Supabase CLI stack; no keys are needed here.

# --- Gotenberg (DOCX -> PDF conversion) ----------------------------------------------
# LibreOffice conversion API: http://localhost:3009. Read by @odb/templates when
# converting generated DOCX files to PDF.
GOTENBERG_URL=http://localhost:3009

# --- Documenso (e-sign) ---------------------------------------------------------------
# App: http://localhost:3005
# Requires infra/documenso/cert.p12 (see infra/documenso/README.md).
DOCUMENSO_DB_USER=documenso
DOCUMENSO_DB_PASSWORD=documenso
DOCUMENSO_DB_NAME=documenso
DOCUMENSO_URL=http://localhost:3005
# Generate each secret with: openssl rand -base64 32
DOCUMENSO_NEXTAUTH_SECRET=
DOCUMENSO_ENCRYPTION_KEY=
DOCUMENSO_ENCRYPTION_SECONDARY_KEY=
# Passphrase used when creating cert.p12 (see infra/documenso/README.md).
DOCUMENSO_SIGNING_PASSPHRASE=changeit
# Point SMTP at a local catcher; Supabase Inbucket listens on host port 54325 by default.
DOCUMENSO_SMTP_TRANSPORT=smtp-auth
DOCUMENSO_SMTP_HOST=host.docker.internal
DOCUMENSO_SMTP_PORT=54325
DOCUMENSO_SMTP_USERNAME=
DOCUMENSO_SMTP_PASSWORD=
DOCUMENSO_SMTP_FROM_NAME=OpenDealbook Local
DOCUMENSO_SMTP_FROM_ADDRESS=noreply@opendealbook.local

# --- Novu (notifications, profile: notifications) ------------------------------------
# Self-hosted Novu CE. UIs/APIs on localhost:
#   API: http://localhost:3006   WS: http://localhost:3007   Dashboard: http://localhost:3008
# MongoDB and novu-redis are internal to the compose network (not published).
NOVU_MONGO_USER=root
NOVU_MONGO_PASSWORD=secret
# Generate each secret with: openssl rand -base64 32
NOVU_JWT_SECRET=
NOVU_SECRET_KEY=
# Encrypts stored provider credentials; must be EXACTLY 32 characters.
NOVU_STORE_ENCRYPTION_KEY=
NOVU_NODE_ENV=local
NOVU_DISABLE_USER_REGISTRATION=false
NOVU_API_ROOT_URL=http://localhost:3006
NOVU_WS_URL=http://localhost:3007
# App-side: @odb/notifications reaches the Novu API from the host at NOVU_API_URL and
# authenticates with the API key created in the Novu dashboard after first startup.
NOVU_API_URL=http://localhost:3006
NOVU_API_KEY=

# --- Observability (profile: observability) ------------------------------------------
# Grafana LGTM + profiling stack. UIs:
#   Prometheus: http://localhost:9090   Grafana: http://localhost:3001
#   Loki: http://localhost:3100         Tempo:   http://localhost:3200
#   Pyroscope: http://localhost:4040    OTLP:    grpc 4317 / http 4318
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin

# App instrumentation endpoints (consumed by the app OTEL + profiling wiring, a separate
# later lane). These point at the collector and Pyroscope on published localhost ports.
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_SERVICE_NAME=opendealbook-web
PYROSCOPE_SERVER_ADDRESS=http://localhost:4040

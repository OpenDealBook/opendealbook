NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_DEFAULT_LOCALE=en
NEXT_PUBLIC_LOCALES=en
NEXT_PUBLIC_DEFAULT_TIMEZONE=UTC

STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_SENTRY_DSN=
GOTENBERG_URL=http://localhost:3009

# Dev and test only: set to 1 to let AI calls reach a private or localhost base URL
# (the e2e LLM stand-in). It takes effect only when ODB_STACK is local or e2e, so a
# production deploy ignores it. Never set either in production. To also save such a
# URL in settings, run once against the local database as supabase_admin:
#   docker exec supabase_db_tuckin psql -U supabase_admin -d postgres \
#     -c "alter database postgres set odb.allow_private_ai_url = 'on'"
ODB_ALLOW_PRIVATE_AI_URL=
ODB_STACK=
